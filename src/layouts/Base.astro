---
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  lang?: 'ja' | 'en';
  alternatePath?: string;
}

const { title, description, lang = 'ja', alternatePath } = Astro.props;
const copy = lang === 'en'
  ? {
      home: '/en/', game: '/en/waribashi/', privacy: '/en/waribashi/privacy/',
      skip: 'Skip to content', navigation: 'Main navigation',
      gameName: 'Waribashi - Chopsticks Battle', privacyLabel: 'Waribashi privacy policy',
      alternateLabel: '日本語', alternateLang: 'ja',
    }
  : {
      home: '/', game: '/waribashi/', privacy: '/waribashi/privacy/',
      skip: '本文へ移動', navigation: 'メインナビゲーション',
      gameName: '割り箸バトル', privacyLabel: '割り箸バトルのプライバシーポリシー',
      alternateLabel: 'English', alternateLang: 'en',
    };
const jaPath = lang === 'ja' ? Astro.url.pathname : alternatePath;
const enPath = lang === 'en' ? Astro.url.pathname : alternatePath;
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {alternatePath && (
      <>
        <link rel="alternate" hreflang="ja" href={new URL(jaPath!, Astro.site)} />
        <link rel="alternate" hreflang="en" href={new URL(enPath!, Astro.site)} />
      </>
    )}
  </head>
  <body class="flex min-h-screen flex-col">
    <a href="#main" class="sr-only focus:not-sr-only focus:absolute focus:z-10 focus:bg-white focus:p-4">{copy.skip}</a>
    <header class="border-b border-ink/10">
      <nav aria-label={copy.navigation} class="mx-auto flex max-w-5xl flex-wrap items-center justify-between gap-4 px-6 py-6 sm:px-10">
        <a href={copy.home} class="text-lg font-bold tracking-tight sm:text-xl">Meowtaverse Games</a>
        <div class="flex flex-wrap items-center gap-4 text-sm">
          <a href={copy.game} class="text-accent underline">{copy.gameName}</a>
          {alternatePath && <a href={alternatePath} lang={copy.alternateLang} hreflang={copy.alternateLang} class="text-accent underline">{copy.alternateLabel}</a>}
        </div>
      </nav>
    </header>
    <main id="main" class="mx-auto w-full max-w-5xl flex-1 px-6 py-12 sm:px-10 sm:py-20">
      <slot />
    </main>
    <footer class="border-t border-ink/10">
      <div class="mx-auto flex max-w-5xl flex-col gap-3 px-6 py-8 text-xs text-slate-600 sm:flex-row sm:items-center sm:justify-between sm:px-10">
        <p>© 2026 Meowtaverse Games</p>
        <a href={copy.privacy} class="underline">{copy.privacyLabel}</a>
      </div>
    </footer>
  </body>
</html>
