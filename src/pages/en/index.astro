---
import Base from '../../layouts/Base.astro';
---

<Base lang="en" alternatePath="/" title="Meowtaverse Games — A little friendly competition, every day." description="Meowtaverse Games is an independent game brand making games you can pick up and enjoy. Discover Waribashi - Chopsticks Battle, a finger strategy game.">
  <section class="pb-14 sm:pb-20">
    <p class="eyebrow mb-6">SMALL GAMES, PLAYFUL MOMENTS.</p>
    <h1 class="max-w-3xl text-4xl leading-snug font-bold tracking-tight sm:text-5xl">A little friendly competition,<br />every day.</h1>
    <p class="mt-6 max-w-xl text-slate-600">Meowtaverse Games is an independent game brand making games that are easy to pick up and hard to put down.</p>
  </section>

  <section aria-labelledby="games-heading">
    <h2 id="games-heading" class="mb-5 text-sm font-semibold tracking-wider">Games</h2>
    <article class="rounded-3xl border border-ink/10 bg-white p-7 sm:p-10">
      <p class="eyebrow mb-3">TURN-BASED STRATEGY</p>
      <h3 class="text-2xl font-bold sm:text-3xl"><a href="/en/waribashi/" class="hover:text-accent">Waribashi - Chopsticks Battle</a></h3>
      <p class="mt-4 max-w-xl text-slate-600">Add fingers, split them, and knock out both of your opponent’s hands. The familiar finger game becomes a simple yet thoughtful strategy game.</p>
      <div class="mt-7 flex flex-wrap items-center gap-5">
        <a href="https://apps.apple.com/app/id6760738303" class="button">View on the App Store</a>
        <a href="/en/waribashi/" class="text-link text-sm">About the game</a>
      </div>
      <p class="mt-4 text-sm text-slate-500">Android version coming soon</p>
    </article>
  </section>

  <section class="mt-14 border-t border-ink/10 pt-8" aria-labelledby="contact-heading">
    <h2 id="contact-heading" class="mb-2 text-lg font-semibold">Contact</h2>
    <a href="mailto:tokusei@meowtaverse-games.com" class="text-link">tokusei@meowtaverse-games.com</a>
  </section>
</Base>
